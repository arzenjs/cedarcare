AUTH_SECRET=bbef8deab6514e415ffeba43da902c68c3684b7e3ad1a29622377d9579a5c4c3

# Public URL of the site (no trailing slash). Used for email links.
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Resend ----
RESEND_API_KEY=re_replace_me
# Must be on a domain you verified in Resend. For quick tests use: onboarding@resend.dev
RESEND_FROM_EMAIL=CedarCare Family Clinic <onboarding@resend.dev>

# ---- First administrator (used by: npm run create-admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-12+chars

# ---- Optional ----
# Interactive embedded map (the site works without it, using Google Maps links).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Where website contact-form messages are emailed (falls back to the clinic email)
CONTACT_TO_EMAIL=
